+// Windows ignores IP_UNICAST_IF on dual-stack sockets, so with --out-if
+// and the default "::" bind address IPv4 traffic uses plain IPv4 sockets
+static int split_stack(void)
+{
+    #ifdef _WIN32
+    return params.out_if && params.baddr.sin6_family == AF_INET6
+        && IN6_IS_ADDR_UNSPECIFIED(&params.baddr.sin6_addr);
+    #else
+    return 0;
+    #endif
+}
+
+
+// Socket family and bind address for a destination; a UDP relay uses
+// one socket, which is IPv4 in split-stack mode
+static void out_addr(struct sockaddr_ina *dst, struct sockaddr_ina *baddr, int udp)
+{
+    memset(baddr, 0, sizeof(*baddr));
+    baddr->in6 = params.baddr;
+    if (split_stack()) {
+        map_fix(dst, 0);
+        if (udp || dst->sa.sa_family == AF_INET) {
+            memset(baddr, 0, sizeof(*baddr));
+            baddr->in.sin_family = AF_INET;
+        }
+        return;
+    }
+    map_fix(dst, baddr->sa.sa_family == AF_INET6 ? 6 : 0);
+}
