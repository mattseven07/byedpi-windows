+int bind_out_if(int fd, int family, int need6)
+{
+    #ifdef _WIN32
+    static int warned6 = 0;
+    if (!params.out_if) {
+        return 0;
+    }
+    // IPv4 index is in network byte order, IPv6 in host order.
+    // IPv4 traffic uses plain IPv4 sockets (split_stack in proxy.c).
+    // IPV6_UNICAST_IF fails (WSAEINVAL) if IPv6 is unbound on the
+    // interface, which only matters for real IPv6 destinations
+    DWORD idx4 = htonl(params.out_if), idx6 = params.out_if;
+
+    if (setsockopt(fd, IPPROTO_IP, IP_UNICAST_IF,
+            (char *)&idx4, sizeof(idx4)) && family == AF_INET) {
+        uniperror("setsockopt IP_UNICAST_IF");
+        return -1;
+    }
+    if (family == AF_INET6 && setsockopt(fd, IPPROTO_IPV6,
+            IPV6_UNICAST_IF, (char *)&idx6, sizeof(idx6))) {
+        if (need6) {
+            uniperror("setsockopt IPV6_UNICAST_IF");
+            return -1;
+        }
+        if (!warned6) {
+            warned6 = 1;
+            LOG(LOG_E, "IPv6 unavailable on interface %u, IPv4 only\n", params.out_if);
+        }
+    }
+    #endif
+    return 0;
+}
